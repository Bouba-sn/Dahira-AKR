# Dahira AKR - Apache Configuration
Options -Indexes

# Sécurité des fichiers sensibles
<Files "*.php">
    # Autoriser par défaut
</Files>

<FilesMatch "^(database\.php|\.env|.*\.sql|run_migration.*\.php|generate_.*\.php)$">
    Require all denied
</FilesMatch>

# Protéger le répertoire config
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Redirection HTTPS automatique en production (compatible InfinityFree et Cloudflare)
    RewriteCond %{HTTPS} off
    RewriteCond %{HTTP:X-Forwarded-Proto} !https
    RewriteCond %{HTTP_HOST} !localhost [NC]
    RewriteCond %{HTTP_HOST} !\.test$ [NC]
    RewriteCond %{HTTP_HOST} !^127\.0\.0\.1
    RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # Bloquer l'accès direct au config/
    RewriteRule ^config/ - [F,L]

    # Bloquer l'accès aux scripts de migration
    RewriteRule ^run_migration - [F,L]
    RewriteRule ^generate_ - [F,L]

    # Page d'accueil
    RewriteRule ^$ pages/accueil.php [L]

    # Nettoyer les URL (optionnel)
    # RewriteCond %{REQUEST_FILENAME} !-f
    # RewriteCond %{REQUEST_FILENAME} !-d
    # RewriteRule ^(.*)$ index.php?route=$1 [L,QSA]
</IfModule>

# Headers de sécurité
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-XSS-Protection "1; mode=block"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"

    # Cache statique assets (30 jours) pour chargement instantané
    <FilesMatch "\.(ico|css|js|gif|jpe?g|png|svg|webp|woff2?)$">
        Header set Cache-Control "max-age=2592000, public"
    </FilesMatch>
</IfModule>

# Compression gzip
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript text/plain application/json
</IfModule>

# Types MIME
AddType application/manifest+json .json
AddType text/cache-manifest .appcache
AddType image/webp .webp
